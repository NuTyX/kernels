description='NVIDIA modules for the 6.18 LTS Linux Kernel version.'
url='https://www.nvidia.com/en-us/drivers/unix/'

packager="tnut <tnut@nutyx.org>"

license="custom"

name=nvidia-580-kernel-618
version=580.196.07
release=4

run=(kernel-618)
KERNELNAME="${name#nvidia-580-}"

source=(0001-Enable-atomic-kernel-modesetting-by-default.patch
        0002-Fix-hardware-cursor-crash.patch
        https://download.nvidia.com/XFree86/Linux-x86_64/$version/NVIDIA-Linux-x86_64-$version.run)
prepare() {
 sh NVIDIA-Linux-x86_64-$version.run --extract-only
 patch -Np1 -i $SRC/0001-Enable-atomic-kernel-modesetting-by-default.patch -d $SRC/NVIDIA-Linux-x86_64-$version/kernel
 patch -Np1 -i $SRC/0002-Fix-hardware-cursor-crash.patch -d $SRC/NVIDIA-Linux-x86_64-$version/kernel

}
build()
{
 
 cd NVIDIA-Linux-x86_64-$version/kernel

 SYSSRC="/usr/src/$KERNELNAME" make modules
 install -dm0755 $PKG/usr/lib/modules/$KERNELNAME/kernel/drivers/video
 install -m0644 *.ko $PKG/usr/lib/modules/$KERNELNAME/kernel/drivers/video
 echo "cards.depmod(\"$(basename /usr/lib/modules/6.18.*)\")" > $PKGMK_ROOT/$name.post-install.lua
}

